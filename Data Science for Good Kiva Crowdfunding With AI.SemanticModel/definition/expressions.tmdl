expression stg_KivaCountryMap =
		let
		    // MPI spells nine country names differently from kiva_loans; this lets the two files be related by country.
		    // The 'ofa' in Palestine is a footnote marker fused into the source text, not a typo introduced here.
		    #"Defined MPI To Kiva Country Map" = [
		        #"Bolivia, Plurinational State of" = "Bolivia",
		        #"Congo, Republic of" = "Congo",
		        #"Cote d'Ivoire" = "Cote D'Ivoire",
		        #"Moldova, Republic of" = "Moldova",
		        #"Myanmar" = "Myanmar (Burma)",
		        #"Palestine, State ofa" = "Palestine",
		        #"Tanzania, United Republic of" = "Tanzania",
		        #"Congo, Democratic Republic of the" = "The Democratic Republic of the Congo",
		        #"Viet Nam" = "Vietnam"
		    ]
		in
		    #"Defined MPI To Kiva Country Map"
	lineageTag: fed772a9-c8e9-4d1e-8edb-9b7c7181a325

